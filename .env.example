# Copy to .env and fill in. ./setup.sh generates the passwords for you.
# .env is gitignored — never commit it.
#
# For TrueNAS SCALE, values go into deploy/truenas/compose.yaml instead; this file is
# for running the stack locally with Docker Compose.

# --- sidecar database ---------------------------------------------------------
SIDECAR_DB_USER=fitness
SIDECAR_DB_PASSWORD=

# --- wger ---------------------------------------------------------------------
# Reachable from inside the Docker network. `web` is wger's own service name.
WGER_BASE_URL=http://web:8000
# Generate a permanent token in wger: log in, then visit /en/user/api-key
WGER_API_TOKEN=

# --- LLM gateway --------------------------------------------------------------
# Provider-neutral: anything speaking the OpenAI chat-completions API works.
#
#   OmniRoute (self-hosted)   http://<host-ip>:20128/v1  (separate app = separate
#                             Docker network, so use the host IP, not a service name)
#   OpenRouter (cloud)        https://openrouter.ai/api/v1
#   Ollama (local model)      http://<host>:11434/v1
#   vLLM / LM Studio          http://<host>:<port>/v1
LLM_BASE_URL=http://127.0.0.1:20128/v1
# With a self-hosted gateway the real provider keys live in the gateway, but the
# OpenAI SDK still requires a non-empty value here.
LLM_API_KEY=local-gateway

# --- model routing ------------------------------------------------------------
# These ids must match what YOUR gateway advertises. Check GET /capabilities on the
# agent (port 8100) — it lists advertised model ids and probes each configured model
# for native tool calling and structured-output support.
#
# Do not assume one gateway's naming works on another: OpenRouter uses
# `provider/model`, a bare Ollama uses `model:tag`.
MODEL_ROUTINE=anthropic/claude-sonnet-5
MODEL_ROUTINE_ESCALATION=anthropic/claude-opus-5
MODEL_VARIATION=anthropic/claude-sonnet-5
MODEL_CRITIC=anthropic/claude-sonnet-5

# --- misc ---------------------------------------------------------------------
AGENT_PORT=8100
# Must match wger's TIME_ZONE. A mismatch dates evening workouts to the next day,
# because log dates and the recent-training window both use the container's today().
TZ=America/Chicago
